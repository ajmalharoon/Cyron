# Copy to .env and fill in locally. Leave anything you don't use blank.
# Never commit the real .env file.

# --- Core ---
CYRON_API_KEY=
DATABASE_URL=postgresql+asyncpg://cyron:cyron@db:5432/cyron
CORS_ORIGINS=http://localhost:5173
TOOL_TIMEOUT_SECONDS=300
SCAN_OUTPUT_DIR=/data/scan-output

# --- Passive intelligence sources (optional, enable what you have) ---
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
FOFA_EMAIL=
FOFA_API_KEY=
NVD_API_KEY=

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=cyron
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=cyron
